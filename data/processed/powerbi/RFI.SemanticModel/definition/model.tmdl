model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table dim_date
ref table dim_party
ref table dim_tasked_party
ref table dim_discipline
ref table dim_issue_type
ref table fact_rfi
ref table Measures
ref expression DataFolder
ref cultureInfo en-US

annotation PBI_QueryOrder = ["dim_date","dim_party","dim_discipline","dim_issue_type","fact_rfi","dim_tasked_party","Measures"]
